# Central Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# --- Server ---
PORT=3001
NODE_ENV=development

# --- MongoDB ---
# For local development: mongodb://localhost:27017/api-guardian
# For MongoDB Atlas: paste your full connection string here
MONGODB_URI=mongodb://localhost:27017/api-guardian

# --- Security ---
# A long random string used to sign API keys. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

